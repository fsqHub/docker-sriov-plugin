          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Key Points Box -->
        <mxCell id="key_box" value="关键点" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="280" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="key1" value="1. IPvlan 虚拟设备无独立 NAPI 实例" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="key_box">
          <mxGeometry x="20" y="40" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="key2" value="2. 所有数据包在 PF 的 NAPI poll 中处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="key_box">
          <mxGeometry x="20" y="70" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="key3" value="3. rx_handler 在驱动 poll 交给协议栈后执行" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="key_box">
          <mxGeometry x="20" y="100" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="key4" value="4. 只修改 skb-&gt;dev 等元数据&#xa;   不拷贝 skb-&gt;data 指向的数据" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="key_box">
          <mxGeometry x="20" y="130" width="240" height="40" as="geometry" />
        </mxCell>

        <mxCell id="key5" value="5. 通过 netns 切换将数据包路由到&#xa;   目标容器的协议栈" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="key_box">
          <mxGeometry x="20" y="175" width="240" height="40" as="geometry" />
        </mxCell>

        <mxCell id="key6" value="6. 返回 RX_HANDLER_ANOTHER&#xa;   触发协议栈重新处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="key_box">
          <mxGeometry x="20" y="220" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- Source Code Box -->
        <mxCell id="src_box" value="源码位置" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="280" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="src1" value="rx_handler 注册：&#xa;drivers/net/ipvlan/ipvlan_main.c:136" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontFamily=Courier New;" vertex="1" parent="src_box">
