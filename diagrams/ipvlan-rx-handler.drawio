        <mxCell id="src2" value="rx_handler 调用点：&#xa;net/core/dev.c:5585" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontFamily=Courier New;" vertex="1" parent="src_box">
          <mxGeometry x="20" y="80" width="240" height="35" as="geometry" />
        </mxCell>

        <mxCell id="src3" value="IPvlan 核心处理：&#xa;drivers/net/ipvlan/ipvlan_core.c" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontFamily=Courier New;" vertex="1" parent="src_box">
          <mxGeometry x="20" y="120" width="240" height="35" as="geometry" />
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="注：IPvlan 模式下，容器共享 PF 的 NAPI 实例；同 CPU 本轮 net_rx_action()&#xa;共同消耗 netdev_budget 和 netdev_budget_usecs。rx_handler 在同一软中断路径中执行。" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1360" width="880" height="40" as="geometry" />
        </mxCell>

      </root>
