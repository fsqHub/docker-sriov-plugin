          </mxGeometry>
        </mxCell>

        <!-- Modify skb -->
        <mxCell id="modify_skb" value="修改 skb 元数据：&#xa;skb-&gt;dev = ipvlan_dev;&#xa;（指向容器的 IPvlan 虚拟设备）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="970" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;flowAnimation=1;" edge="1" parent="1" source="lookup" target="modify_skb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- dev_forward_skb -->
        <mxCell id="forward_skb" value="dev_forward_skb(skb)&#xa;重置 MAC header，调整 metadata&#xa;切换到目标容器的 netns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="1070" width="320" height="60" as="geometry" />
