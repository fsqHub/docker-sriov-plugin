        </mxCell>

        <!-- Return RX_HANDLER_ANOTHER -->
        <mxCell id="return_another" value="return RX_HANDLER_ANOTHER;&#xa;重新进入协议栈处理&#xa;（在容器 netns 中）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="1170" width="320" height="60" as="geometry" />
