          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Container Protocol Stack -->
        <mxCell id="container_proto" value="容器 netns 中的协议栈处理&#xa;IP 层 → TCP 层 → socket 队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="1270" width="320" height="60" as="geometry" />
