          <mxGeometry x="100" y="420" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="res5" value="&lt;b&gt;PCIe 带宽&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="res6" value="&lt;b&gt;路由表锁&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- IPvlan Heatmap -->
        <mxCell id="ipv_cpu" value="&lt;b&gt;非常高&lt;/b&gt;&#xa;40 容器共享宿主机 CPU&#xa;软中断集中在少数核心" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff5252;strokeColor=#c62828;fontSize=11;fontColor=#fff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ipv_queue" value="&lt;b&gt;高&lt;/b&gt;&#xa;共享 PF 队列（8-16 个）&#xa;40 容器竞争" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff7043;strokeColor=#d84315;fontSize=11;fontColor=#fff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="240" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ipv_netns" value="&lt;b&gt;极高&lt;/b&gt;&#xa;每个数据包都切换&#xa;40 倍累加" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d32f2f;strokeColor=#b71c1c;fontSize=11;fontColor=#fff;fontStyle=1;" vertex="1" parent="1">
