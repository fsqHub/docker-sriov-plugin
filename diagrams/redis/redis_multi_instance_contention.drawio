        </mxCell>
        <mxCell id="vf_vf" value="&lt;b&gt;中等&lt;/b&gt;&#xa;40 个 VF（最多 64）&#xa;接近上限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="420" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vf_pcie" value="&lt;b&gt;中等&lt;/b&gt;&#xa;40 VF 共享 10Gbps&#xa;平均 250Mbps/VF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1">
