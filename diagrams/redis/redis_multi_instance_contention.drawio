        <mxCell id="vf_netns" value="&lt;b&gt;无&lt;/b&gt;&#xa;容器独立 netns&#xa;不经过宿主机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#81c784;strokeColor=#388e3c;fontSize=11;" vertex="1" parent="1">
