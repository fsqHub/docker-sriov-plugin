        </mxCell>
        <mxCell id="vf_queue" value="&lt;b&gt;低&lt;/b&gt;&#xa;每个 VF 独立队列（2-4 个）&#xa;无竞争" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#aed581;strokeColor=#689f38;fontSize=11;" vertex="1" parent="1">
