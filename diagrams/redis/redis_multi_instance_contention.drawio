          <mxGeometry x="650" y="420" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="host_pcie" value="&lt;b&gt;低&lt;/b&gt;&#xa;通过 PF 共享 PCIe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#aed581;strokeColor=#689f38;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="510" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="host_route" value="&lt;b&gt;高&lt;/b&gt;&#xa;共享路由表和 conntrack&#xa;全局锁竞争" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff7043;strokeColor=#d84315;fontSize=11;fontColor=#fff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="600" width="350" height="60" as="geometry" />
        </mxCell>

        <!-- VF Passthrough Heatmap -->
        <mxCell id="vf_cpu" value="&lt;b&gt;中等&lt;/b&gt;&#xa;独立中断分散到多核&#xa;IOMMU 页表竞争" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1">
