        <mxCell id="ipv_route" value="&lt;b&gt;中等&lt;/b&gt;&#xa;容器独立路由表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1">
