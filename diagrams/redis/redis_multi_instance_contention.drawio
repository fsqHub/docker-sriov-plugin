        <mxCell id="res3" value="&lt;b&gt;netns 切换&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
