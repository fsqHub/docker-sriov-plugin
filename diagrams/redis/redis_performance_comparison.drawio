        </mxCell>
        <mxCell id="ipv_qps_label" value="&lt;b&gt;60%&lt;/b&gt;&#xa;60K QPS" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=11;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="180" width="80" height="40" as="geometry" />
