        <mxCell id="user3" value="readQueryFromClient()&#xa;RESP 协议解析 → 命令执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" vertex="1" parent="1">
