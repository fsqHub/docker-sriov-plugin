        <mxCell id="user1" value="&lt;b&gt;epoll_wait() 返回&lt;/b&gt;&#xa;系统调用返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="610" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="user2" value="&lt;b&gt;read() 系统调用&lt;/b&gt;&#xa;内核→用户态拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="610" width="220" height="40" as="geometry" />
