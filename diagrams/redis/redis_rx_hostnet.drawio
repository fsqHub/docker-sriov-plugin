        <mxCell id="perf3" value="✓ 完整的硬件卸载支持（RSS、TSO、GSO、Checksum Offload）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="875" width="440" height="20" as="geometry" />
