<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Host Network RX Path">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Host Network 模式 - Redis 数据接收路径&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Physical Layer -->
        <mxCell id="hw_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hw_label" value="&lt;b&gt;物理层&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="90" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hw1" value="物理网卡 (PF)&#xa;DMA 到内核 RX buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="130" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hw2" value="硬件中断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Host netns (shared) -->
        <mxCell id="host_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="220" width="500" height="300" as="geometry" />
        </mxCell>
        <mxCell id="host_label" value="&lt;b&gt;内核态 - 宿主机 netns（容器共享）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#6a1b9a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="230" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="host1" value="NAPI 软中断&#xa;ixgbe_clean_rx_irq()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="270" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="host2" value="napi_gro_receive()&#xa;GRO 聚合优化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="270" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="host3" value="&lt;b&gt;__netif_receive_skb_core()&lt;/b&gt;&#xa;无 rx_handler 拦截（直通）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5e1a5;strokeColor=#558b2f;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="330" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="host4" value="TCP/IP 协议栈处理&#xa;tcp_v4_rcv() / udp_rcv()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="395" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="host5" value="加入 socket 接收队列&#xa;唤醒 Redis 进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="460" width="420" height="40" as="geometry" />
        </mxCell>

        <!-- User Space -->
        <mxCell id="user_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="user_label" value="&lt;b&gt;用户态 - Redis 进程&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#e65100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="570" width="200" height="30" as="geometry" />
