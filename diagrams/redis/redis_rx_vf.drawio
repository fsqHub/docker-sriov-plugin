        <mxCell id="hw_label" value="&lt;b&gt;物理层 - VF 硬件&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
