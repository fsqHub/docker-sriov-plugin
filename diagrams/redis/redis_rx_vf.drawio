        <mxCell id="title" value="&lt;b&gt;VF 直通模式 - Redis 数据接收路径&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="600" height="40" as="geometry" />
