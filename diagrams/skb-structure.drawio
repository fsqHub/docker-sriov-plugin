        </mxCell>

        <mxCell id="ptr_data" value="unsigned char *data;&#xa;当前数据指针（协议栈处理时移动）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="skb_struct_box">
