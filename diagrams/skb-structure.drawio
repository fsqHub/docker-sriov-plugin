        <mxCell id="ptr_head" value="unsigned char *head;&#xa;数据区起始（固定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="skb_struct_box">
