            <mxPoint x="280" y="120" as="sourcePoint"/>
            <mxPoint x="280" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="ptr_end_arrow" value="end" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="layout_box">
          <mxGeometry x="330" y="25" width="50" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ptr_end_line" value="" style="endArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="layout_box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="360" y="120" as="sourcePoint"/>
            <mxPoint x="360" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Operations -->
        <mxCell id="ops_label" value="协议栈处理时指针移动" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="layout_box">
          <mxGeometry x="40" y="140" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ops_rx" value="• RX 路径：data 指针向右移动 (skb_pull)&#xa;  逐层剥离协议头 (Ethernet → IP → TCP)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="layout_box">
          <mxGeometry x="40" y="165" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ops_tx" value="• TX 路径：data 指针向左移动 (skb_push)&#xa;  逐层添加协议头 (TCP → IP → Ethernet)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="layout_box">
          <mxGeometry x="40" y="210" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Key Operations Table -->
        <mxCell id="ops_table_box" value="关键操作函数" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="400" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="ops1" value="alloc_skb() - 分配 skb 结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="ops_table_box">
          <mxGeometry x="20" y="40" width="360" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ops2" value="skb_clone() - 克隆 skb（共享数据，无拷贝）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="ops_table_box">
          <mxGeometry x="20" y="70" width="360" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ops3" value="skb_push() - data 指针前移（添加头部）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="ops_table_box">
          <mxGeometry x="20" y="100" width="360" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ops4" value="skb_pull() - data 指针后移（移除头部）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="ops_table_box">
          <mxGeometry x="20" y="130" width="360" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ops5" value="kfree_skb() - 释放 skb（引用计数归零）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="ops_table_box">
          <mxGeometry x="20" y="160" width="360" height="25" as="geometry"/>
        </mxCell>

        <!-- IPvlan Modification -->
        <mxCell id="ipvlan_box" value="IPvlan 的 skb 处理（无数据拷贝）" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="380" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="ipvlan_step1" value="1. PF 驱动分配 skb，skb-&gt;data 指向 DMA buffer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ipvlan_box">
          <mxGeometry x="20" y="40" width="340" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ipvlan_step2" value="2. rx_handler 拦截，修改 skb-&gt;dev 指向 IPvlan 虚拟设备" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="ipvlan_box">
          <mxGeometry x="20" y="65" width="340" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ipvlan_step3" value="3. dev_forward_skb() 调整 metadata（重置 MAC header 等）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="ipvlan_box">
          <mxGeometry x="20" y="90" width="340" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ipvlan_note" value="✓ 只修改 skb 结构体的 metadata，不拷贝 skb-&gt;data 指向的数据区域" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="ipvlan_box">
          <mxGeometry x="20" y="110" width="340" height="20" as="geometry" />
        </mxCell>

        <!-- Note -->
        <mxCell id="note_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="820" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="note_text" value="关键结论：三种 Docker 网络模式在内核协议栈中都是通过 skb 指针传递，不拷贝数据区域。&#xa;唯一的数据拷贝发生在用户态边界：RX 路径的 read()（skb → 用户态 buffer），TX 路径的 write()（用户态 buffer → skb）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="690" width="780" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
